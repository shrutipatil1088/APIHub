# ==============================================================================
# APIHub Environment Configuration Template (.env.example)
# Copy this file to '.env' (for local execution) or '.env.docker' (for Docker execution).
# NEVER commit real secret keys or production passwords to version control.
# ==============================================================================

# Django Core Settings
SECRET_KEY=replace-with-a-secure-random-secret-key
DEBUG=True

# Database Configuration (PostgreSQL container service name: 'db' in Docker, 'localhost' for local OS)
POSTGRES_DB=apihub_db
POSTGRES_USER=apihub_user
POSTGRES_PASSWORD=apihub_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DB_NAME=apihub_db
DB_USER=apihub_user
DB_PASSWORD=apihub_password
DB_HOST=db
DB_PORT=5432

# Redis & Celery Configuration (Redis container service name: 'redis' in Docker, '127.0.0.1' for local OS)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
